<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key><array><string>group.com.hybrid.fakelag</string></array>
	<key>com.apple.developer.networking.networkextension</key><array><string>packet-tunnel-provider</string><string>app-proxy-provider</string><string>content-filter-provider</string><string>dns-proxy</string></array>
	<!-- Tunnel extension extras: the relay engine mirrors its config/log to
	     /var/mobile/Library/Caches so the app + root HUD daemon can read them
	     even when the App Group container is not resolvable inside the
	     provider process (TrollStore signs these private keys). -->
	<key>com.apple.private.security.no-sandbox</key><true/>
	<key>platform-application</key><true/>
	<key>com.apple.private.network.socket-delegate</key><true/>
	<key>com.apple.private.networkextension.packet-tunnel</key><true/>
</dict>
</plist>
