<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Quyền Network Extension cần thiết -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>
    
    <!-- Cho phép app và extension chạy ngoài sandbox (cần cho TrollStore) -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    
    <!-- Quyền quản lý VPN nâng cao -->
    <key>com.apple.private.networkextension.manager</key>
    <true/>
    <key>com.apple.private.networkextension.packet-tunnel-provider</key>
    <true/>
    
    <!-- Quyền can thiệp vào cơ chế bộ nhớ (chống kill) -->
    <key>com.apple.private.memorystatus</key>
    <true/>
    
    <!-- App Group để giao tiếp giữa app và extension -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.ban.PacketBlocker</string>
    </array>
</dict>
</plist>
